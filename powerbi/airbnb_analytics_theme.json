{
  "name": "Airbnb Analytics",
  "dataColors": [
    "#1D4ED8",
    "#F59E0B",
    "#14B8A6",
    "#8B5CF6",
    "#EF4444",
    "#64748B",
    "#0EA5E9",
    "#10B981"
  ],
  "background": "#FFFFFF",
  "backgroundLight": "#F1F5F9",
  "backgroundNeutral": "#E2E8F0",
  "foreground": "#334155",
  "foregroundNeutralSecondary": "#64748B",
  "foregroundNeutralTertiary": "#CBD5E1",
  "tableAccent": "#1D4ED8",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "minimum": "#DBEAFE",
  "center": "#60A5FA",
  "maximum": "#1D4ED8",
  "null": "#CBD5E1",
  "hyperlink": "#1D4ED8",
  "visitedHyperlink": "#7C3AED",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 14
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 10
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 10
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": false
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 10
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 11
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}